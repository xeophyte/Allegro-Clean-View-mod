{
   "action": {
      "default_icon": {
         "128": "icons/icon-128.png",
         "16": "icons/icon-16.png",
         "32": "icons/icon-32.png",
         "48": "icons/icon-48.png"
      },
      "default_popup": "popup.html",
      "default_title": "Allegro Clean View (mod)"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "product-offers-instant-hide.css" ],
      "js": [ "product-offers-content.js" ],
      "matches": [ "https://allegro.pl/oferty-produktu/*" ],
      "run_at": "document_start"
   }, {
      "css": [ "listing-instant-hide.css" ],
      "js": [ "listing-content.js" ],
      "matches": [ "https://allegro.pl/kategoria/*", "https://allegro.pl/listing*" ],
      "run_at": "document_start"
   }, {
      "css": [ "misc-instant-hide.css" ],
      "js": [ "misc-content.js" ],
      "matches": [ "https://allegro.pl/*" ],
      "run_at": "document_start"
   }, {
      "css": [ "product-page-instant-hide.css" ],
      "js": [ "content.js" ],
      "matches": [ "https://allegro.pl/produkt/*", "https://allegro.pl/oferta/*" ],
      "run_at": "document_start"
   }, {
      "css": [ "cart-instant-hide.css" ],
      "js": [ "cart-content.js" ],
      "matches": [ "https://allegro.pl/koszyk" ],
      "run_at": "document_start"
   }, {
      "css": [ "transaction-instant-hide.css" ],
      "js": [ "transaction-content.js" ],
      "matches": [ "https://allegro.pl/transakcja/dziekujemy*" ],
      "run_at": "document_start"
   }, {
      "css": [ "favorites-instant-hide.css" ],
      "js": [ "favorites-content.js" ],
      "matches": [ "https://allegro.pl/moje-allegro/zakupy/obserwowane/ulubione" ],
      "run_at": "document_start"
   }, {
      "css": [ "my-purchases-instant-hide.css" ],
      "js": [ "my-purchases-content.js" ],
      "matches": [ "https://allegro.pl/moje-allegro/zakupy/*" ],
      "run_at": "document_start"
   } ],
   "description": "Ukrywa zbędne elementy na stronach Allegro",
   "icons": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Allegro Clean View (mod)",
   "permissions": [ "storage", "tabs" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.0"
}
